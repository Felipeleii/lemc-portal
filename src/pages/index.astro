---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

const allPubs = await getCollection('publications');
const featuredPubs = allPubs
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const recentPubs = featuredPubs.length
  ? featuredPubs
  : allPubs.sort((a, b) => b.data.year - a.data.year).slice(0, 3);

const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout title={t('nav.home')} lang={lang}>

  <!-- HERO -->
  <section class="bg-lemc-blue text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4 tracking-tight">
        {t('hero.title')}
      </h1>
      <p class="text-lemc-gold font-semibold text-lg mb-6 leading-snug">
        {t('hero.subtitle')}
      </p>
      <p class="text-blue-100 text-base sm:text-lg max-w-2xl mx-auto mb-10 leading-relaxed">
        {t('hero.description')}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/research" class="px-6 py-3 bg-lemc-green text-white font-semibold rounded-lg hover:bg-green-700 transition-colors">
          {t('hero.cta.research')}
        </a>
        <a href="/publications" class="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
          {t('hero.cta.publications')}
        </a>
      </div>
    </div>
  </section>

  <!-- PROJECT ARIES HIGHLIGHT -->
  <section class="py-16 px-4 bg-slate-50">
    <div class="max-w-5xl mx-auto">
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-slate-100">
        <div class="bg-gradient-to-r from-lemc-blue to-lemc-green h-2 w-full"></div>
        <div class="p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
          <div class="shrink-0">
            <div class="w-16 h-16 rounded-xl bg-lemc-blue flex items-center justify-center">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" aria-hidden="true">
                <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
              </svg>
            </div>
          </div>
          <div class="flex-1">
            <div class="inline-block bg-lemc-gold/20 text-lemc-gold font-semibold text-xs px-2 py-0.5 rounded mb-2 uppercase tracking-wider">
              Flagship Project
            </div>
            <h2 class="text-2xl font-bold text-lemc-blue mb-2">
              {t('section.aries.title')}
            </h2>
            <p class="text-sm text-lemc-green font-medium mb-4">
              {t('section.aries.subtitle')}
            </p>
            <p class="text-slate-600 leading-relaxed mb-6">
              {t('section.aries.description')}
            </p>
            <a href="/research#aries" class="inline-flex items-center gap-2 text-lemc-blue font-semibold hover:text-lemc-green transition-colors">
              {t('section.aries.cta')}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RECENT PUBLICATIONS -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-lemc-blue">{t('section.recent_pubs')}</h2>
        <a href="/publications" class="text-lemc-green font-semibold text-sm hover:underline">{t('section.view_all')} →</a>
      </div>

      {recentPubs.length > 0 ? (
        <ul class="space-y-4">
          {recentPubs.map((pub) => (
            <li class="bg-white rounded-xl border border-slate-100 shadow-sm p-5 hover:shadow-md transition-shadow">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-slate-800 mb-1 leading-snug">{pub.data.title}</h3>
                  <p class="text-sm text-slate-500 mb-1">{pub.data.authors.join(', ')}</p>
                  <p class="text-xs text-lemc-green font-medium">{pub.data.journal} · {pub.data.year}</p>
                </div>
                {pub.data.doi && (
                  <a
                    href={`https://doi.org/${pub.data.doi}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="shrink-0 text-xs bg-lemc-blue text-white px-2.5 py-1 rounded hover:bg-lemc-green transition-colors"
                  >
                    DOI
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-slate-400 text-sm">No publications yet. Add Markdown files to <code>src/content/publications/</code>.</p>
      )}
    </div>
  </section>

  <!-- RECENT NEWS -->
  <section class="py-16 px-4 bg-slate-50">
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-lemc-blue">{t('section.recent_news')}</h2>
        <a href="/news" class="text-lemc-green font-semibold text-sm hover:underline">{t('section.view_all')} →</a>
      </div>

      {recentNews.length > 0 ? (
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {recentNews.map((article) => (
            <article class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden hover:shadow-md transition-shadow">
              <div class="h-2 bg-gradient-to-r from-lemc-blue to-lemc-green"></div>
              <div class="p-5">
                <time class="text-xs text-slate-400 mb-2 block">{article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                <h3 class="font-semibold text-slate-800 mb-2 leading-snug text-sm">{article.data.title}</h3>
                <p class="text-xs text-slate-500 leading-relaxed line-clamp-3">{article.data.summary}</p>
                <a href={`/news/${article.slug}`} class="mt-3 inline-block text-xs font-semibold text-lemc-green hover:underline">
                  Read more →
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-slate-400 text-sm">No news yet. Add Markdown files to <code>src/content/news/</code>.</p>
      )}
    </div>
  </section>

</Layout>

