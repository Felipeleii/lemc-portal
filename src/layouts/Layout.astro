---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description = 'LEMC/ALERTA – Clinical Microbiology Research Portal at UNIFESP', lang: langProp } = Astro.props;
const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang: Lang = lang === 'en' ? 'pt' : 'en';
const altLangLabel = altLang === 'pt' ? 'PT' : 'EN';

const navItems = [
  { key: 'nav.research' as const, href: getLocalePath(lang, '/research') },
  { key: 'nav.publications' as const, href: getLocalePath(lang, '/publications') },
  { key: 'nav.news' as const, href: getLocalePath(lang, '/news') },
  { key: 'nav.team' as const, href: getLocalePath(lang, '/team') },
];

const currentPath = new URL(Astro.url).pathname;

function altLangHref(): string {
  // Strip current lang prefix to get the bare path, then prepend altLang
  const stripped = currentPath.replace(/^\/(en|pt)\//, '/').replace(/^\/(en|pt)$/, '/');
  return getLocalePath(altLang, stripped);
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | LEMC/ALERTA · UNIFESP</title>
  </head>
  <body class="bg-white text-slate-800 flex flex-col min-h-screen">

    <!-- ===== HEADER ===== -->
    <header class="bg-lemc-blue text-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">

          <!-- Logo / Brand -->
          <a href={getLocalePath(lang, '/')} class="flex items-center gap-3 group" aria-label="LEMC/ALERTA Home">
            <div class="w-9 h-9 rounded-full bg-lemc-green flex items-center justify-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
              </svg>
            </div>
            <span class="font-bold text-lg leading-tight tracking-wide group-hover:text-lemc-gold transition-colors">LEMC / ALERTA</span>
          </a>

          <!-- Desktop Nav -->
          <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
            {navItems.map(({ key, href }) => (
              <a
                href={href}
                class:list={[
                  'px-3 py-1.5 rounded text-sm font-medium transition-colors',
                  currentPath === href || currentPath.startsWith(href + '/')
                    ? 'bg-white/20 text-white'
                    : 'text-blue-100 hover:bg-white/10 hover:text-white',
                ]}
              >
                {t(key)}
              </a>
            ))}

            <!-- Language toggle -->
            <a
              href={altLangHref()}
              class="ml-3 px-3 py-1.5 border border-white/40 rounded text-xs font-semibold text-white hover:bg-white/20 transition-colors"
              aria-label={`Switch to ${altLangLabel}`}
            >
              {altLangLabel}
            </a>
          </nav>

          <!-- Mobile menu button -->
          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded text-blue-100 hover:bg-white/10"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"/>
              <line x1="3" y1="12" x2="21" y2="12"/>
              <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>
        </div>

        <!-- Mobile Nav -->
        <nav id="mobile-menu" class="md:hidden hidden pb-3 border-t border-white/20 mt-1 pt-2" aria-label="Mobile navigation">
          {navItems.map(({ key, href }) => (
            <a
              href={href}
              class="block px-3 py-2 text-sm font-medium text-blue-100 hover:bg-white/10 hover:text-white rounded transition-colors"
            >
              {t(key)}
            </a>
          ))}
          <a
            href={altLangHref()}
            class="block mt-2 px-3 py-1.5 text-xs font-semibold text-white border border-white/40 rounded hover:bg-white/20 transition-colors w-fit"
          >
            {altLangLabel}
          </a>
        </nav>
      </div>
    </header>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="bg-slate-900 text-slate-300 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

          <!-- Brand column -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 rounded-full bg-lemc-green flex items-center justify-center">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                </svg>
              </div>
              <span class="font-bold text-white">LEMC / ALERTA</span>
            </div>
            <p class="text-sm text-slate-400">{t('footer.affiliation')}</p>
          </div>

          <!-- Links column -->
          <div>
            <h3 class="font-semibold text-white mb-3 text-sm uppercase tracking-wider">Links</h3>
            <ul class="space-y-1.5 text-sm">
              {navItems.map(({ key, href }) => (
                <li>
                  <a href={href} class="hover:text-white transition-colors">{t(key)}</a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Social / External -->
          <div>
            <h3 class="font-semibold text-white mb-3 text-sm uppercase tracking-wider">Connect</h3>
            <div class="flex gap-3">
              <!-- ORCID -->
              <a
                href="https://orcid.org"
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-full bg-slate-700 hover:bg-lemc-green flex items-center justify-center transition-colors"
                aria-label="ORCID"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm-1.5 4.5a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm-.5 3.5h2v7H10V10z"/>
                </svg>
              </a>
              <!-- GitHub -->
              <a
                href="https://github.com/Felipeleii/lemc-portal"
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-full bg-slate-700 hover:bg-slate-500 flex items-center justify-center transition-colors"
                aria-label="GitHub"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                </svg>
              </a>
              <!-- Twitter / X -->
              <a
                href="https://twitter.com"
                target="_blank"
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-full bg-slate-700 hover:bg-sky-600 flex items-center justify-center transition-colors"
                aria-label="Twitter / X"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- UNIFESP branding bar -->
        <div class="mt-8 pt-6 border-t border-slate-700 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <!-- UNIFESP text logo placeholder -->
            <span class="text-xs font-bold tracking-widest text-slate-400 uppercase border border-slate-600 px-2 py-0.5 rounded">UNIFESP</span>
            <span class="text-xs text-slate-500">Universidade Federal de São Paulo</span>
          </div>
          <p class="text-xs text-slate-500">
            © {new Date().getFullYear()} LEMC/ALERTA · {t('footer.rights')}
          </p>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>

