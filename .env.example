# ============================================================
# LEMC/ALERTA Portal – Environment Variables
# ============================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# For Cloudflare Pages / GitHub Pages deployment, add these
# variables in the platform's "Environment Variables" settings.
# ============================================================

# ------------------------------------------------------------------
# ORCID Member API credentials
#
# Register your application at https://orcid.org/developer-tools
# to obtain a Client ID and Client Secret.
#
# These are used by src/lib/orcid.ts to authenticate against the
# ORCID Member API for full publication metadata retrieval.
# ------------------------------------------------------------------
ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ------------------------------------------------------------------
# ORCID researcher ID(s)
#
# The ORCID iD(s) of the researcher(s) whose publications should
# be synchronised at build time.  Format: 0000-0000-0000-0000
# ------------------------------------------------------------------
ORCID_RESEARCHER_ID=0000-0000-0000-0000
